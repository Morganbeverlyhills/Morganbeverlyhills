{
  "name": "blockchain-bulk-sms",
  "version": "1.0.0",
  "description": "Professional and highly secure bulk SMS system using Blockchain technology",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.js",
    "test": "hardhat test",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm install && cd frontend && npm install && cd ../contracts && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "twilio": "^4.19.3",
    "ethers": "^6.9.0",
    "web3": "^4.3.0",
    "redis": "^4.6.12",
    "bull": "^4.12.2",
    "joi": "^17.11.0",
    "rate-limiter-flexible": "^5.0.3",
    "crypto": "^1.0.1",
    "winston": "^3.11.0",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "hardhat": "^2.19.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.0.1",
    "chai": "^4.3.10",
    "@nomiclabs/hardhat-ethers": "^2.2.3"
  },
  "keywords": [
    "blockchain",
    "sms",
    "bulk-messaging",
    "ethereum",
    "smart-contracts",
    "security"
  ],
  "author": "Blockchain SMS System",
  "license": "MIT"
}